{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug dshell",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/dshell",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Follow parent process after fork",
          "text": "set follow-fork-mode parent",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "make debug"
    }
  ]
}